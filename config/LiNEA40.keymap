#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義
#define ARROW_NUM 1
#define ARROW_SIGN 2
#define FUNCTION 3
#define MOUSE 4
#define SCROLL 5
#define WIRELESS 6
#define MOUSE_RIGHT 7
#define MOUSE_LEFT 8


//mouse cursol (LiNEA40 標準)
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll (LiNEA40 標準)
&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

// Seaside39 から移植
&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <300>;
    tapping-term-ms = <200>;
};

// Seaside39 から移植
&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <300>;
    tapping-term-ms = <200>;
};

/ {
    // LiNEA40 標準
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

// LiNEA40 標準
&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

// LiNEA40 標準
&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // LiNEA40 標準コンボ
        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };

        // Seaside39 から移植コンボ
        right_ctrl {
            bindings = <&kp RCTRL>;
            key-positions = <28 29>;
        };

        left_ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <30 31>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        ctrl_shift {
            bindings = <&kp LS(LCTRL)>;
            key-positions = <20 21>;
        };

        scroll_rihgt {
            bindings = <&mo 5>; // SCROLL (5)
            key-positions = <18 19>;
        };

        scroll_left {
            bindings = <&mo 5>; // SCROLL (5)
            key-positions = <13 14>;
        };

        MB3_RIGHT {
            bindings = <&mkp MB3>;
            key-positions = <17 18>;
        };
    };

    // Seaside39 から移植マクロ
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        // LiNEA40 標準 behavior
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        // Seaside39 から移植 behavior
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            quick-tap-ms = <300>;
            tapping-term-ms = <200>;
        };

        // 「balanced」な mod-tap
        mt_balanced: mod_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_BALANCED";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        td_z_shft: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Z>, <&kp LSHFT>;
        };

        lt_balanced: lt_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BALANCED";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Seaside39 default_layer (0) を移植
        default_layer {
            bindings = <
&kp Q                      &kp W                      &kp E                      &kp R                      &kp T                                          &kp Y                      &kp U                      &kp I                      &kp O                      &kp P
&kp A                      &kp S                      &kp D                      &kp F                      &kp G                                          &kp H                      &kp J                      &kp K                      &kp L                      &kp SEMICOLON
&mt_balanced LEFT_SHIFT Z  &kp X                      &kp C                      &kp V                      &kp B                                          &kp N                      &kp M                      &kp COMMA                  &kp DOT                    &mt_balanced RIGHT_SHIFT SLASH
&mo 8                      &kp LEFT_WIN               &kp LEFT_ALT               &lt 4 LANGUAGE_2          &lt_balanced 2 SPACE       &lt 5 LANG1                 &lt 2 BACKSPACE            &lt 3 ENTER                 &trans                     &trans                     &lt 7 ESCAPE
            >;

            // LiNEA40 標準の sensor-bindings を維持
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        // Seaside39 MOUSE (4) を LiNEA40 MOUSE (1) へ移植
        MOUSE {
            bindings = <
&trans                     &trans                     &trans                     &trans                     &trans                                         &trans                     &trans                     &trans                     &trans                     &trans
&trans                     &trans                     &mkp MB2                   &mkp MB1                   &mo 5                                          &trans                     &mkp MB1                   &mkp MB3                   &mkp MB2                   &mo 5
&trans                     &trans                     &trans                     &trans                     &mkp MB3                                       &trans                     &trans                     &trans                     &trans                     &trans
&trans                     &trans                     &trans                     &trans                     &trans                     &trans                      &trans                     &trans                     &trans                     &trans                     &trans
            >;
        };

        // Seaside39 ARROW_SIGN (2) を LiNEA40 MARK (2) へ移植
        MARK {
            bindings = <
&kp LS(EXCL)               &kp LS(AT)                 &kp LS(POUND)              &kp LS(DLLR)               &kp LS(PRCNT)                                  &kp LC(W)                  &kp LC(R)                  &kp LC(T)                  &kp LC(LS(T))              &mt PLUS EQUAL
&kp LS(CARET)              &kp LS(AMPS)               &kp LS(STAR)               &kp LS(LPAR)               &kp LS(RPAR)                                   &kp LC(PAGE_UP)            &kp LC(HOME)               &kp LA(UP_ARROW)           &kp LC(END)                &mt UNDER MINUS
&trans                     &mt PIPE BACKSLASH         &mt TILDE GRAVE            &mt LEFT_BRACE LEFT_BRACKET &mt RIGHT_BRACE RIGHT_BRACKET                 &kp LC(PAGE_DOWN)          &kp LA(LEFT)               &kp LA(DOWN)               &kp LA(RIGHT)              &mt DOUBLE_QUOTES SINGLE_QUOTE
&trans                     &trans                     &trans                     &trans                     &trans                     &mo 6                       &kp DELETE                 &trans                     &trans                     &trans                     &kp LG(L)
            >;

            // LiNEA40 標準の sensor-bindings を維持
            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        // Seaside39 ARROW_NUM (1) を LiNEA40 CURSOR (3) へ移植
        CURSOR {
            bindings = <
&kp TAB                    &kp N7                     &kp N8                     &kp N9                     &mt ASTERISK EQUAL                             &kp LEFT_PARENTHESIS       &kp RIGHT_PARENTHESIS      &kp F10                    &kp RIGHT_ALT              &kp TAB
&trans                     &kp N4                     &kp N5                     &kp N6                     &mt PLUS MINUS                                 &kp PAGE_UP                &kp HOME                   &kp UP_ARROW               &kp END                    &kp COLON
&mt_balanced LEFT_SHIFT N0 &kp N1                     &kp NUMBER_2               &kp NUMBER_3               &mt COMMA DOT                                  &kp PAGE_DOWN              &kp LEFT_ARROW             &kp DOWN                   &kp RIGHT                  &mt RIGHT_SHIFT SLASH
&trans                     &trans                     &trans                     &kp LEFT_ALT               &trans                     &kp LEFT_GUI                &kp DELETE                 &trans                     &trans                     &trans                     &trans
            >;
        };

        // Seaside39 FUNCTION (3) を LiNEA40 FUNCTION (4) へ移植
        FUNCTION {
            bindings = <
&kp NUMBER_1               &kp NUMBER_2               &kp NUMBER_3               &kp NUMBER_4               &kp N5                                         &kp NUMBER_6               &kp N7                     &kp N8                     &kp N9                     &kp N0
&trans                     &kp F2                     &kp F3                     &kp F4                     &kp F5                                         &kp PAGE_UP                &kp HOME                   &kp UP_ARROW               &kp END                    &kp MINUS
&trans                     &kp F7                     &kp F8                     &kp F9                     &kp F10                                        &kp PAGE_DOWN              &kp LEFT                   &kp DOWN                   &kp RIGHT                  &trans
&trans                     &trans                     &trans                     &trans                     &trans                     &trans                      &kp DELETE                 &trans                     &trans                     &trans                     &trans
            >;

            // LiNEA40 標準の sensor-bindings を維持
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        // Seaside39 SCROLL (5) を LiNEA40 SCROLL (5) へ移植
